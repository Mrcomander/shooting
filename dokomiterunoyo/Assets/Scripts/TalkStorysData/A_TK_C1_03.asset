  m_Script: {fileID: 11500000, guid: 5a51659b9da73494e8667fc1d95e6ec3, type: 3}
  m_Name: A_TK_C1_03
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u300C\u5927\u597D\u304D\u3060\u306A\u3093\u3066\u3001\u305D\u3093\u306A\u3053\u3068\u306A\u3044\u2026\u2026\u3067\u3059\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u300C\u3044\u3084\u3001\u3042\u306E\u8A9E\u308A\u53E3\u3067\u300E\u307B\u3069\u307B\u3069\u300F\u306F\u7121\u7406\u304C\u3042\u308B\u3068\u601D\u3046\u3051\u3069\u2026\u2026\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u3067\u3001\u30C7\u30B9\u30E8\u30CD\u30FC\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3044\u3084\u3001\u3067\u3082\u307B\u3093\u3068\u306B\u3059\u3054\u3044\u3088\u3002\u3042\u3093\u3060\u3051\u306E\u71B1\u91CF\u3067\u8A9E\u308C\u308B\u3068\u304B\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u308C\u2026\u2026\u4E00\u756A\u50B7\u3064\u304F\u8A00\u8449\u306A\u3093\u3067\u3059\u30B1\u30C9\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3042\u3063\u3001\u3044\u3084\u3001\u2026\u2026\u305D\u306E\u3001\u3054\u3081\u3093\u306A\u3055\u3044\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3075\u3075\u3063\u3001\u5197\u8AC7\u3067\u3059\u3088\u30FC\u3063\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u6383\u9664\u5F53\u756A\u3001\u3072\u3068\u308A\u3067\u3084\u3063\u3066\u305F\u3093\u3067\u3059\u3088\u306D\uFF1F\u3000\u5927\u5909\u3058\u3083\u306A\u304B\u3063\u305F\u3067\u3059\u304B\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3042\u30FC\u3001\u3044\u3084\u3002\u9014\u4E2D\u307E\u3067\u306F\u3051\u3063\u3053\u3046\u3044\u305F\u3093\u3060\u3051\u3069\u3002\u30D0\u30A4\u30C8\u3068\u304B\u90E8\u6D3B\u3068\u304B\u3067\u307F\u3093\u306A\u5E30\u3063\u3061\u3083\u3063\u3066\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u306A\u308B\u307B\u3069\u2026\u2026\u307E\u305F\u4F3C\u305F\u3088\u3046\u306A\u3053\u3068\u304C\u3042\u308C\u3070\u3001\u79C1\u306B\u9060\u616E\u306A\u304F\u8A00\u3063\u3066\u304F\u3060\u3055\u3044\u306D\uFF1F\u3000\u4E00\u56DE\u76EE\u306F\u307E\u3060\u3057\u3082\u3001\u4E8C\u56DE\u3082\u62BC\u3057\u4ED8\u3051\u3089\u308C\u305F\u3068\u3042\u308C\u3070\u3001\u6D41\u77F3\u306B\u770B\u904E\u3067\u304D\u307E\u305B\u3093\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u4E86\u89E3\u3002\u3044\u3056\u3068\u306A\u3063\u305F\u3089\u3001\u983C\u3089\u305B\u3066\u3082\u3089\u3044\u307E\u3059\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u3001\u79C1\u306F\u3053\u306E\u30AF\u30E9\u30B9\u306E\u59D4\u54E1\u9577\u3067\u3059\u304B\u3089\u3002\u3069\u3057\u3069\u3057\u983C\u3063\u3066\u306D\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3053\u306E\u4EBA\u306F\u2026\u2026\u307E\u3063\u3059\u3050\u306A\u4EBA\u306A\u3093\u3060\u308D\u3046\u306A\u3002\u81EA\u5206\u306E\u4FE1\u5FF5\u306B\u3082\u3001\u300E\u597D\u304D\u300F\u306B\u3082\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3084\u3063\u3071\u308A\u3001\u61A7\u308C\u308B\u306A\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3067\u306F\u2026\u2026\u307E\u305F\u660E\u65E5\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u3002\u3058\u3083\u3042\u6C17\u3092\u4ED8\u3051\u3066\u306D\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3048\u3048\u3001\u3042\u306A\u305F\u3082\u3002\u6C17\u3092\u4ED8\u3051\u3066\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u2026\u2026\u2026\u2026\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u307E\u3055\u304B\u3001\u3053\u3093\u306A\u3053\u3068\u306B\u306A\u308B\u3068\u306F\u306A\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u6383\u9664\u5F53\u756A\u3092\u304C\u3093\u3070\u3063\u305F\u3054\u8912\u7F8E\u3001\u3063\u3066\u3068\u3053\u308D\u304B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3055\u3066\u3001\u4FFA\u3082\u5E30\u308A\u652F\u5EA6\u3092\u3057\u306A\u3044\u3068\uFF09"
    CharacterName: "\u81EA\u5206"
  endType: 0
