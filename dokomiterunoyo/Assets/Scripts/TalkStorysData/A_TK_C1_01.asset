  m_Script: {fileID: 11500000, guid: 5a51659b9da73494e8667fc1d95e6ec3, type: 3}
  m_Name: A_TK_C1_01
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u3042\u3001\u3053\u308C\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u597D\u304D\u306A\u306E\u3001\u3063\u3066\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u3002\u307E\u3041\u3001\u3061\u3087\u3063\u3068\u3060\u3051\u3001\u3067\u3059\u3051\u3069\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u306E\u3082\u3058\u3082\u3058\u3057\u3066\u308B\u306E\u306F\u306A\u306B\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3093\u2026\u2026\u3063\u3066\u3001\u306A\u3093\u304B\u6065\u305A\u304B\u3057\u3044\u3058\u3083\u306A\u3044\u3067\u3059\u304B\u2026\u2026\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3060\u3063\u3066\u3001\u3053\u3046\u3044\u3046\u306E\u3002\u306A\u3093\u3066\u3044\u3046\u304B\u2026\u2026\u7537\u306E\u5B50\u306E\u30B7\u30E5\u30DF\u3068\u3044\u3046\u304B\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3079\u3064\u306B\u3001\u305D\u3093\u306A\u3053\u3068\u306A\u3044\u3068\u601D\u3046\u3051\u3069\u3002\u597D\u304D\u306A\u3089\u3001\u81EA\u4FE1\u3092\u6301\u3063\u305F\u307B\u3046\u304C\u3044\u3044\u3068\u601D\u3044\u307E\u3059\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3075\u3075\u3001\u3044\u3044\u3053\u3068\u8A00\u3046\u3093\u3067\u3059\u306D\u3002\u3042\u308A\u304C\u3068\u3046\u3054\u3056\u3044\u307E\u3059\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u308C\u3067\u3001\u306A\u3093\u304B\u304D\u3063\u304B\u3051\u3068\u304B\u3042\u308B\u3093\u3067\u3059\u304B\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u3002\u307E\u3041\u306A\u3093\u3066\u3044\u3046\u304B\u3001\u308F\u305F\u3057\u3001\u5F1F\u304C\u3044\u308B\u3093\u3067\u3059\u3051\u3069\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u5F1F\u306E\u4E16\u8A71\u304C\u3066\u3089\u3001\u8272\u3005\u898B\u3066\u305F\u3089\u2026\u2026\u3060\u3093\u3060\u3093\u30AB\u30C3\u30B3\u3044\u3044\u306A\u3041\uFF5E\u3063\u3066\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u306A\u308B\u307B\u3069\u3002\u3061\u306A\u307F\u306B\u3001\u3069\u306E\u30B7\u30EA\u30FC\u30BA\u304C\u4E00\u756A\u597D\u304D\u306A\u3093\u3067\u3059\u304B\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3069\u306E\u30B7\u30EA\u30FC\u30BA\u304C\uFF1F\u3000\u3048\u30FC\u3001\u3080\u305A\u304B\u3057\u3044\u30B7\u30C4\u30E2\u30F3\u3067\u3059\u306D\u2026\u2026\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3067\u3082\u3084\u3063\u3071\u308A\u2026\u2026\u300E|\u5E7D\u5C01\u300A\u3086\u3046\u3075\u3046\u300B\u6226\u968A\u3000\u30AA\u30CF\u30E9\u30A4\u30B8\u30E3\u30FC\u300F\u304B\u306A\u3041\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3042\u3063\u3001\u305D\u308C\u306A\u3089\u4FFA\u3082\u77E5\u3063\u3066\u2015\u2015\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3048\u3063\uFF01\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2015\u2015\u541B\u3082\u898B\u3066\u305F\u306E\u3063\uFF01\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3042\u3042\u2026\u2026\u305D\u3063\u304B\uFF01\u3000\u78BA\u304B\u306B\u4E16\u4EE3\u3058\u3083\u3093\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u5B9F\u306F\u3042\u306E\u30B7\u30EA\u30FC\u30BA\u306D\u3001\u6B74\u4EE3\u30B7\u30EA\u30FC\u30BA\u306E\u306A\u304B\u3067\u3082\u7D50\u69CB\u7279\u6B8A\u306A\u30B7\u30FC\u30BA\u30F3\u306A\u3093\u3060\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u307B\u3001\u307B\u3046\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u30AA\u30CF\u30E9\u30A4\u30A4\u30A8\u30ED\u30FC\u304C\u9014\u4E2D\u3067\u6575\u306B\u6355\u307E\u3063\u3061\u3083\u3063\u3066\u3001\u6575\u306B\u6191\u308A\u3064\u304B\u308C\u308B\u30B7\u30FC\u30F3\u304C\u3042\u308B\u3093\u3060\u3051\u3069\u306D\u2026\u2026\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u3082\u305D\u3082\u4E00\u4EBA\u3060\u3051\u6355\u307E\u3063\u3061\u3083\u3046\u3053\u3068\u3082\u3042\u3093\u307E\u308A\u306A\u3044\u3093\u3060\u3051\u3069\u3001\u305D\u306E\u5F8C\u30AA\u30CF\u30E9\u30A4\u30A4\u30A8\u30ED\u30FC\u306F\u81EA\u6211\u3092\u5931\u3063\u3066\u4ED6\u306E\u30E1\u30F3\u30D0\u30FC\u305F\u3061\u3068\u5BFE\u7ACB\u3059\u308B\u306E\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3078\u3001\u3078\u3047\u2026\u2026\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u4ED6\u306B\u3082\u30D6\u30EB\u30FC\u304C\u5B9F\u306F\u6575\u3067\u3042\u308B\u30E6\u30A6\u30EC\u30A4\u5074\u306A\u306E\u306B\u88CF\u5207\u3063\u3066\u4E3B\u4EBA\u516C\u30B5\u30A4\u30C9\u306B\u5C5E\u3057\u3066\u308B\u3068\u304B\u6700\u7D42\u56DE\u306E\u3072\u3068\u3064\u524D\u3067\u4E00\u5EA6\u5168\u6EC5\u30A8\u30F3\u30C9\u307F\u305F\u3044\u306B\u306A\u3063\u3061\u3083\u3046\u3068\u3053\u308D\u3068\u304B\u3001\u30AA\u30EC\u300A\u30FB\u30FB\u203B\u508D\u70B9\u5165\u308C\u3068\u3044\u3066\u300B\u7684\u306B\u8272\u3005\u6FC0\u30A2\u30C4\u306E\u5C55\u958B\u304C\u591A\u304F\u3066\u3055\u30A1\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u308C\u307E\u3067\u306E\u30B7\u30EA\u30FC\u30BA\u3067\u306F\u3042\u307E\u308A\u306A\u304B\u3063\u305F\u3088\u3046\u306A\u5C55\u958B\u3068\u304B\u8A2D\u5B9A\u304C\u3066\u3093\u3053\u76DB\u308A\u306A\u306E\u306B\u305D\u308C\u3089\u5168\u90E8\u3092\u3046\u307E\u304F\u6271\u3063\u3066\u3066\uFF01\u3000\u300E\u30AA\u30CF\u30E9\u30A4\u30B8\u30E3\u30FC\u300F\u306F\u30DE\u30CB\u30A2\u306E\u306A\u304B\u3067\u3082\u7279\u306B\u30D5\u30A1\u30F3\u306E\u591A\u3044\u30B7\u30EA\u30FC\u30BA\u306A\u3093\u3060\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u7279\u306B\u30AA\u30EC\u300A\u30FB\u30FB\u203B\u508D\u70B9\u300B\u304C\u597D\u304D\u306A\u306E\u306F\u6700\u7D42\u56DE\u3067\u3055\u30A1\u3063\uFF01\u3000\u3055\u3044\u3054\u3001\u3053\u308C\u307E\u3067\u8DB3\u3092\u3072\u3063\u3071\u308A\u304C\u3061\u3060\u3063\u305F\u30A4\u30A8\u30ED\u30FC\u304C\u899A\u9192\u3057\u3066\u6575\u306B\u5927\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u3066\u3055\u30A1\u3063\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u3093\u3067\u305D\u3093\u3067\uFF01\u3000\u3084\u3063\u3063\u3071\u308A\u6700\u5F8C\u306F\u30EC\u30C3\u30C9\u304C\u6C7A\u3081\u308B\u3093\u3060\u3088\uFF01\u3000\u4ECA\u307E\u307E\u3067\u5012\u3057\u305F\u6575\u306E\u5206\u306E\u30AA\u30CF\u30E9\u30A4\u30D1\u30EF\u30FC\u3082\u5168\u90E8\u3064\u304E\u8FBC\u3093\u3067\u3063\u3001\u5F37\u5927\u306A\u6575\u306B\u6700\u7D42\u5965\u7FA9\u3092\u3076\u3063\u3071\u306A\u3059\u306E\u30A9\u3063\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u30D6\u30EB\u30FC\u30EC\u30A4\u3067\u521D\u3081\u3066\u898B\u305F\u3068\u304D\u306F\u3082\u3046\u3063\uFF01\u3000\u3075\u3049\u304A\u304A\u304A\u304A\u304A\u304A\u304A\u304A\u3063\uFF01\u3000\u304B\u3063\u3051\u30FC\u30FC\u30FC\u30FC\u30FC\u3063\uFF01\uFF01\uFF01\u3000\u3063\u3066\u3055\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3042\u3068\u30AA\u30EC\u7684\u306B\u597D\u304D\u306A\u30DD\u30A4\u30F3\u30C8\u3068\u3057\u3066\u306F\u2026\u2026\u2026\u2026\u3063\u3066\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3042\u3002\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3046\u3054\u304D\u3001\u6B62\u307E\u3063\u305F\u306A\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u2026\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u2026\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\uFF5E\uFF5E\uFF5E\uFF5E\uFF5E\u30C3\u30C3/////////\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\uFF08\u3084\u3001\u3084\u3063\u3061\u3083\u3063\u305F\u2026\u2026\uFF09\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u307E\u3055\u304B\u3001\u4F0A\u624B\u3055\u3093\u306B\u3053\u3093\u306A\u4E00\u9762\u304C\u3042\u3063\u305F\u306A\u3093\u3066\u2026\u2026\uFF09"
    CharacterName: "\u81EA\u5206"
