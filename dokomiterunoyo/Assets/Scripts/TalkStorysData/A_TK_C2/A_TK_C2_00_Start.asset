  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u3058\u3083\u3042\u3053\u3053\u306E6\u884C\u76EE\u3092\u2026\u2026\u4F0A\u624B\u300D"
    CharacterName: "\u5148\u751F"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u2026\u2026\uFF1F\u3000\u304A\u3044\u3001\u4F0A\u624B\u300D"
    CharacterName: "\u5148\u751F"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u300C\u306F\u3072\u3063\uFF01\uFF1F\u3000\u3054\u3001\u3054\u3081\u3093\u3055\u306A\u3044\u3063\u3001\u306A\u3093\u3067\u3059\u304B\u3001\u571F\u5C71\u5148\u751F\u300D"
    CharacterName: "\u4F0A\u624B"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u2026\u202666\u30DA\u30FC\u30B8\u306E6\u884C\u76EE\u3060\u3002\u8A33\u3057\u3066\u307F\u308D\u300D"
    CharacterName: "\u5148\u751F"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u300C\u306F\u3001\u306F\u3044\u3063\u2026\u2026\u3093\u3093\u3068\u3001\u3053\u308C\u306F\u2015\u2015\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u2026\u2026\uFF1F\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u4E3B\u4EBA\u516C\uFF08\u307C\u30FC\u3063\u3068\u3057\u3066\u305F\u306E\u304B\u306A\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u4E3B\u4EBA\u516C\uFF08\u73CD\u3057\u3044\u306A\u3002\u4F0A\u624B\u3055\u3093\u304C\u6388\u696D\u4E2D\u306B\u3088\u305D\u898B\u306A\u3093\u3066\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u4E3B\u4EBA\u516C\uFF08\u2026\u2026\u306A\u3093\u304B\u3001\u60A9\u307F\u3054\u3068\u3067\u3082\u3042\u3093\u306E\u304B\u306A\uFF09"
    CharacterName: "\u81EA\u5206"
  endType: 0
