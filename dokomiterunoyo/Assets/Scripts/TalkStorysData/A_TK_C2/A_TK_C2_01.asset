  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u3042\u3002\u3044\u305F\u3044\u305F\u3001\u3061\u3087\u3063\u3068\u3044\u3044\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u4E3B\u4EBA\u516C\u300C\u2026\u2026\u2026\u2026\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u2026\u2026\u304A\u30FC\u3044\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u2026\u2026\u3048\u3001\u4FFA\u306E\u3053\u3068\uFF01\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u305D\u3046\u3067\u3059\u3001\u7121\u8996\u3057\u306A\u3044\u3067\u304F\u3060\u3055\u3044\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u3054\u3001\u3054\u3081\u3093\u2026\u2026\u305D\u308C\u3067\u3001\u4F55\u306E\u5FA1\u7528\u3067\u3057\u3087\u3046\u304B\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u305D\u3093\u306A\u754F\u307E\u3089\u306A\u304F\u3066\u3082\u3044\u3044\u3088\uFF1F\u3000\u3048\u3063\u3068\u2026\u2026\u78BA\u304B\u6574\u5099\u59D4\u54E1\u3060\u3063\u305F\u3088\u306D\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u3042\u3042\u3001\u306F\u3044\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u4ECA\u65E5\u306E\u653E\u8AB2\u5F8C\u3001\u77E5\u3063\u3066\u308B\u3068\u601D\u3046\u3051\u3069\u59D4\u54E1\u4F1A\u304C\u3042\u308B\u307F\u305F\u3044\u3060\u304B\u3089\u3001\u3088\u308D\u3057\u304F\u306D\u3002\u6383\u9664\u5F53\u756A\u306F\u3001\u4EE3\u308F\u308A\u306B\u79C1\u304C\u3084\u3063\u3066\u304A\u304F\u304B\u3089\u300D "
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u307B\u3093\u3068\u3067\u3059\u304B\u3001\u3042\u308A\u304C\u3068\u3046\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u300C\u3069\u3046\u3044\u305F\u3057\u307E\u3057\u3066\u3002\u3058\u3083\u3042\u3001\u305D\u308C\u3060\u3051\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\uFF08\u2026\u2026\u2026\u2026\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\uFF08\u6C17\u306B\u3057\u3059\u304E\u306A\u3089\u3001\u305D\u308C\u3067\u3044\u3044\u3051\u3069\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 2f81cd7013ba76a488c8f5edeb8cd66c, type: 3}
    StoryText: "\u4E3B\u4EBA\u516C\uFF08\u3079\u3064\u306B\u3001\u3075\u3064\u3046\u3060\u3063\u305F\u306A\uFF09"
    CharacterName: "\u81EA\u5206"
