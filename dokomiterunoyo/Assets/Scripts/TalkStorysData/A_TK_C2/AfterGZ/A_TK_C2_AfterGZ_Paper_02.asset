  m_Script: {fileID: 11500000, guid: 5a51659b9da73494e8667fc1d95e6ec3, type: 3}
  m_Name: A_TK_C2_AfterGZ_Paper_02
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u306A\u3001\u306A\u3093\u3067\u307D\u304B\u3093\u3068\u3057\u3066\u308B\u3093\u3067\u3059\u304B\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u3048\u3001\u3044\u3084\u2026\u2026\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\uFF08\u597D\u304D\u306A\u3089\u3001\u6065\u305A\u304B\u3057\u304C\u308B\u5FC5\u8981\u306A\u3044\u3068\u601D\u3046\u3051\u3069\u2026\u2026\u305D\u3046\u3082\u3044\u304B\u306A\u3044\u3093\u3060\u308D\u3046\u306A\u3041\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u2026\u2026\u308F\u304B\u308A\u307E\u3057\u305F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u3044\u3063\u305F\u3044\u4F55\u3092\u7406\u89E3\u3057\u305F\u3093\u3067\u3059\u304B\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u89E3\u6C7A\u65B9\u6CD5\u3067\u3059\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u2026\u2026\u305D\u306E\u3001\u7740\u3044\u3066\u304D\u3066\u3001\u4E00\u7DD2\u306B\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u3060\u304B\u3089\uFF01\u3000\u62BD\u9078\u8CA9\u58F2\u3001\u4E00\u7DD2\u306B\u7740\u3044\u3066\u304D\u3066\u307B\u3057\u3044\u306E\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u2026\u2026\u306A\u308B\u307B\u3069\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u3053\u308C\u306A\u3089\u79C1\u306F\u3042\u306A\u305F\u306E\u4ED8\u304D\u6DFB\u3044\u3068\u3044\u3046\u4F53\u306B\u3067\u304D\u308B\u304B\u3089\u6065\u305A\u304B\u3057\u304F\u306A\u3044\u3067\u3059\u3057\u3001\u300D\r\n"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u4E8C\u4EBA\u3044\u305F\u65B9\u304C\u3001\u4E8C\u679A\u3067\u8CB7\u3048\u308B\u78BA\u7387\u3082\u4E0A\u304C\u308B\u304B\u3089\u3001\u307E\u3055\u3057\u304F\u4E00\u77F3\u4E8C\u9CE5\u306E\u7B56\u3068\u3044\u3046\u8A33\u3067\u3059\u300D\r\n"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u2026\u2026\u306A\u308B\u307B\u3069\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\uFF08\u2026\u2026\u3042\u308C\u3001\u305D\u308C\u3063\u3066\u3064\u307E\u308A\u2015\u2015\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: a3714fa955a03244cbbad300b1222933, type: 3}
    StoryText: "\u300C\u4ECA\u9031\u306E\u571F\u66DC\u65E5\u3001\u5348\u524D\u5341\u6642\u306B\u5927\u901A\u308A\u306E\u30B7\u30E7\u30C3\u30D4\u30F3\u30B0\u30E2\u30FC\u30EB\u3067\u3059\u3002\u7A7A\u3044\u3066\u307E\u3059\u304B\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  endType: 1
