    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u300C\u2015\u2015\u3058\u3083\u3042\u3001\u571F\u66DC\u65E5\u306B\u30E2\u30FC\u30EB\u306D\u300D"
