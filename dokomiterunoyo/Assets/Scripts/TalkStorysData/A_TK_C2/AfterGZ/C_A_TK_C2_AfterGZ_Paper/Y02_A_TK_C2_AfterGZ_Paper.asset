    StoryText: "\u300C\u2026\u2026\u3045\u3046\u3046\u3045\u3046\u2026\u2026\u3063\u2026\u2026\u307E\u305F\u3084\u3063\u3061\u3083\u3063\u305F\u2026\u2026\uFF08\u51F9\uFF09\u300D\r\n"
