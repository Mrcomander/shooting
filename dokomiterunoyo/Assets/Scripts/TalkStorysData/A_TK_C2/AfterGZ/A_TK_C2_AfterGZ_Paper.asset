  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u305D\u308C\u3001\u4F55\u306E\u30C1\u30E9\u30B7\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3093\u2026\u2026\uFF1F\u3000\u3042\u3001\u3042\u3041\u3001\u3053\u308C\u3067\u3059\u304B\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u2026\u2026\u2026\u2026\uFF1F\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305A\u3044\u3076\u3093\u3001\u6B6F\u5207\u308C\u306E\u60AA\u3044\u8FD4\u7B54\u3060\u306D\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u3048\u3063\u3068\u3001\u2026\u2026\u2026\u2026\u305D\u306E\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u308F\u3001\u7B11\u308F\u306A\u3044\u3067\u805E\u3044\u3066\u6B32\u3057\u3044\u3093\u3067\u3059\u30B1\u30C9\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u308F\u304B\u3063\u305F\u3001\u7B11\u308F\u306A\u3044\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u307B\u3093\u3068\u3001\u3067\u3059\u304B\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3053\u3053\u304B\u3089\u62B1\u8179\u7D76\u5012\u306E\u4E00\u767A\u30AE\u30E3\u30B0\u304C\u98DB\u3073\u51FA\u3057\u3066\u304F\u308B\u306A\u3089\u3001\u7B11\u3063\u3061\u3083\u3046\u304B\u3082\u300D "
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u307E\u3058\u3081\u306A\u8A71\u3067\u3059\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u308F\u304B\u3063\u305F\u3002\u3058\u3083\u3042\u3001\u7B11\u308F\u306A\u3044\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u3046\u3093\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u305D\u306E\u3001\u3053\u308C\u3001\u306A\u3093\u3067\u3059\u3051\u3069\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3053\u308C\u3001\u306F\u2026\u2026\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3048\u3048\u3068\u300E\u30B2\u30CE\u30E0\u306E\u30A8\u30CB\u30B7\u3000|\uFF24\uFF38\u300A\u30C7\u30E9\u30C3\u30AF\u30B9\u300B\u30AF\u30EA\u30B9\u30D1\u30FC\u30DA\u30A2\u30F3\u3000\u62BD\u9078\u8CA9\u58F2\u4F1A\u300F\u2026\u2026\u3063\u3066\u3001\u3053\u308C\u300D "
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3093\u3068\u2026\u2026\u805E\u3044\u305F\u3053\u3068\u3001\u306A\u3044\uFF1F\u3000\u300E\u30B2\u30CE\u30E0\u306E\u30A8\u30CB\u30B7\u300F\u3063\u3066\u300D "
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3044\u3061\u304A\u3046\u3001\u540D\u524D\u3060\u3051\u306F\u2026\u2026\u3044\u307E\u5C11\u5E74\u8A8C\u3067\u8987\u6A29\u63E1\u3063\u3066\u308B\u30E4\u30C4\u3060\u3088\u306D\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u3046\u3002\u3053\u308C\u3001\u306F\u3001\u305D\u308C\u306E\u2026\u2026\u3054\u306B\u3087\u3054\u306B\u3087\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3093\u3001\u306A\u3093\u3066\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u304A\u3001\u304A\u3082\u3061\u3083\u3001\u306A\u3093\u3067\u3059\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3044\u3061\u3070\u3093\u597D\u304D\u306A\u30AD\u30E3\u30E9\u306E\u2026\u2026\u6B66\u5668\uFF08\u306E\u304A\u3082\u3061\u3083\uFF09\u3067\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u3002\u597D\u304D\u306A\u30AD\u30E3\u30E9\u306E\u30B0\u30C3\u30BA\u306A\u3089\u3001\u6B32\u3057\u304F\u306A\u308B\u3082\u3093\u3060\u3088\u306D\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u305D\u308C\u306F\u3001\u305D\u3046\u3001\u306A\u3093\u3060\u3051\u3069\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u4EBA\u6C17\u904E\u304E\u3066\u5168\u7136\u8CB7\u3048\u306A\u3044\u3057\u2026\u2026\u3067\u3082\u6B32\u3057\u304F\u3066\u2026\u2026\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u2026\u2026\u3060\u304B\u3089\u3001\u3079\u3064\u306B\u884C\u3063\u3066\u6765\u308C\u3070\u3044\u3044\u3093\u3058\u3083\u306A\u3044\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3067\u3082\u2026\u2026\u306F\u3001\u306F\u305A\u304B\u3057\u304F\u3066\u2026\u2026\u3063\u300D\uFF08\u30E2\u30FC\u30B7\u30E7\u30F3\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u2026\u2026\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u2026\u2026\u3060\u304B\u3089\u3001\u3079\u3064\u306B\u884C\u3063\u3066\u6765\u308C\u3070\u3044\u3044\u3093\u3058\u3083\u306A\u3044\uFF1F\u300D"
    CharacterName: "\u81EA\u5206"
  endType: 0
