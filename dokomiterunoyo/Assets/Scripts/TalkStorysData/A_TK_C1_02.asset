  m_Script: {fileID: 11500000, guid: 5a51659b9da73494e8667fc1d95e6ec3, type: 3}
  m_Name: A_TK_C1_02
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u300C\u306A\u3063\u3001\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u300C\u304B\u3001\u304B\u3089\u304B\u308F\u306A\u3044\u3067\u3088\u3049\u2026\u2026\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3045\u2026\u2026\u30AB\u30F3\u30BC\u30F3\u306B\u6211\u3092\u5931\u3063\u3066\u3057\u3083\u3079\u3063\u3061\u3083\u3063\u305F\u2026\u2026\uFF08\u51F9\uFF09\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u306A\u3093\u3066\u3044\u3046\u304B\u2026\u2026\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u601D\u3063\u305F\u3088\u308A\u3001\u304B\u308F\u3044\u3044\u4EBA\u306A\u3093\u3060\u306A\u3002\u59D4\u54E1\u9577\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u3042\u3093\u3067\u3059\u304B\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3044\u3044\u3084\u3001\u3079\u3064\u306B\u2026\u2026\u306A\u3093\u304B\u3001\u30A4\u30E1\u30FC\u30B8\u3057\u3066\u305F\u3088\u308A\u305A\u3063\u3068\u697D\u3057\u3044\u4EBA\u3060\u306A\u3063\u3066\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u308C\u3001\u534A\u5206\u63F6\u63C4\u3063\u3066\u308B\u30C7\u30B7\u30E7\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u30FC\u3093\u3001\u305D\u3093\u306A\u3053\u3068\u306A\u3044\u3051\u3069\u306D\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3059\u3063\u3052\u30FC\u3057\u3063\u304B\u308A\u3057\u3066\u308B\u4EBA\u3063\u3066\u3044\u3046\u304B\u3002\u3061\u3087\u3063\u3068\u7AAE\u5C48\u306A\u611F\u3058\u3082\u3057\u3066\u305F\u304B\u3089\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u304D\u3085\u3046\u304F\u3064\u2026\u2026\u305D\u3093\u306A\u611F\u3058\u3059\u308B\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u591A\u5C11\u306F\uFF1F\u3000\u59D4\u54E1\u9577\u3068\u3057\u3066\u3057\u3063\u304B\u308A\u3057\u306A\u3044\u3068\u30FC\u3001\u307F\u305F\u3044\u306A\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u308C\u3082\u7ACB\u6D3E\u3060\u3068\u601D\u3046\u3051\u3069\u3001\u3055\u3063\u304D\u306E\u4F0A\u624B\u3055\u3093\u2026\u2026\u300E\u597D\u304D\u300F\u306B\u307E\u3063\u3059\u3050\u3067\u3001\u4FFA\u306F\u305D\u3063\u3061\u306E\u4F0A\u624B\u3055\u3093\u3082\u3044\u3044\u306A\u30FC\u3063\u3066\u601D\u3063\u305F\u3088\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u2026\u2026\u3063\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3053\u3001\u3053\u307B\u3093\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3058\u3083\u3042\u3001\u308F\u305F\u3057\u306F\u3053\u308C\u3067\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3093\u3002\u3058\u3083\u3042\u6C17\u3092\u4ED8\u3051\u3066\u306D\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3048\u3048\u3001\u3042\u306A\u305F\u3082\u3002\u304A\u6C17\u3092\u4ED8\u3051\u3066\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u2026\u2026\u2026\u2026\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u307E\u3055\u304B\u3001\u3053\u3093\u306A\u3053\u3068\u306B\u306A\u308B\u3068\u306F\u306A\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u6383\u9664\u5F53\u756A\u3092\u304C\u3093\u3070\u3063\u305F\u3054\u8912\u7F8E\u3001\u3063\u3066\u3068\u3053\u308D\u304B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u2026\u2026\u3055\u3066\u3001\u4FFA\u3082\u5E30\u308A\u652F\u5EA6\u3092\u3057\u306A\u3044\u3068\uFF09"
    CharacterName: "\u81EA\u5206"
  endType: 0
