  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3058\u3083\u3042\u3053\u306E\u554F\u984C\u3092\u2026\u2026\u4ECA\u65E5\u306F\u4E8C\u65E5\u3060\u304B\u3089\u3001\u4F0A\u624B\u3055\u3093\u300D"
    CharacterName: "\u5148\u751F"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u2015\u2015\u306F\u3044\u300D"
    CharacterName: "\uFF1F\uFF1F\uFF1F"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: 
    CharacterName: 
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u7A4F\u3084\u304B\u306A\u663C\u4E0B\u304C\u308A\u306E\u6388\u696D\u3002\u6E05\u3089\u304B\u306A\u58F0\u3068\u5171\u306B\u3001\u5F7C\u5973\u306E\u80CC\u7B4B\u304C\u307E\u3063\u3059\u3050\u4F38\u3073\u308B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u308F\u3041\u3001\u4F0A\u624B\u3055\u3093\u3001\u4ECA\u65E5\u3082\u7D20\u6575\u2026\u2026\uFF01\uFF09"
    CharacterName: "\u5973\u5B50\u751F\u5F92A"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3084\u3063\u3071\u7DBA\u9E97\u3060\u3088\u306A\u3041\u3001\u59D4\u54E1\u9577\u3002\u4ED8\u304D\u5408\u3044\u3066\u30FC\uFF09"
    CharacterName: "\u7537\u5B50\u751F\u5F92A"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3084\u3063\u3071\u7DBA\u9E97\u3060\u3088\u306A\u3041\u3001\u59D4\u54E1\u9577\u3002\u4ED8\u304D\u5408\u3044\u3066\u30FC\uFF09"
    CharacterName: "\u7537\u5B50\u751F\u5F92A"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u5F7C\u5973\u306E\u540D\u524D\u306F\u4F0A\u624B\u6587\u82B1\u300A\u3044\u3066\u3075\u307F\u304B\u300B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3053\u3053\u3001\u8A69\u6CC9\u300A\u3057\u305B\u3093\u300B\u5B66\u5712\uFF11\u5E74\uFF14\u7D44\u306E\u5B66\u7D1A\u59D4\u54E1\u9577\u306B\u3057\u3066\u3001\u5B66\u5E74\u5C48\u6307\u306E\u512A\u7B49\u751F\u3002\u305D\u306E\u30EB\u30C3\u30AF\u30B9\u3068\u3044\u3044\u6027\u683C\u3068\u3044\u3044\u2026\u2026\u3055\u3057\u305A\u3081\u3001\u307F\u3093\u306A\u306E\u4EBA\u6C17\u8005\u3063\u3066\u611F\u3058\u3060\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u304A\u304A\u3001\u3055\u3059\u304C\u4F0A\u624B\u3055\u3093\u3067\u3059\u306D\u3002\u306A\u304B\u306A\u304B\u306B\u96E3\u3057\u3044\u554F\u984C\u306A\u306E\u3067\u3059\u304C\u2026\u2026\u304A\u898B\u4E8B\u3001\u3088\u304F\u52C9\u5F37\u3057\u3066\u3044\u307E\u3059\u306D\u300D"
    CharacterName: "\u5148\u751F"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3044\u3048\u3001\u3061\u3087\u3046\u3069\u6628\u65E5\u4E88\u7FD2\u3057\u305F\u3068\u3053\u308D\u3060\u3063\u305F\u3093\u3067\u3059\u3002\u3050\u3046\u305C\u3093\u3001\u3050\u3046\u305C\u3093\u3067\u3059\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u5ACC\u5473\u3092\u611F\u3058\u3055\u305B\u306A\u3044\u8B19\u905C\u306E\u3042\u3068\u306E\u5FAE\u7B11\u307F\u306B\u3001\u6B53\u58F0\u304C\u4E0A\u304C\u308B\u3002\u5E2D\u3078\u3068\u623B\u308B\u5F7C\u5973\u306E\u59FF\u3092\u3001\u601D\u308F\u305A\u76EE\u3067\u8FFD\u3063\u3066\u3057\u307E\u3046\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u5F8C\u308D\u306E\u65B9\u306E\u5E2D\u3067\u3088\u304B\u3063\u305F\u3002\u3053\u3053\u306A\u3089\u3001\u6388\u696D\u4E2D\u3044\u3064\u3067\u3082\u5F7C\u5973\u306E\u6A2A\u9854\u3092\u62DD\u3080\u3053\u3068\u304C\u3067\u304D\u308B\u306E\u3060\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u2026\u2026\u3060\u3051\u3069\u3001\u6B63\u9762\u304B\u3089\u306E\u9854\u3001\u3042\u3093\u307E\u898B\u305F\u3053\u3068\u306A\u3044\u3093\u3060\u3088\u306A\u3001\u3068\u304B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u305D\u3082\u305D\u3082\u3001\u6328\u62F6\u4EE5\u5916\u3067\u8A71\u3057\u305F\u3053\u3068\u306A\u3044\u3093\u3060\u3088\u306A\u3001\u3068\u304B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u597D\u304D\u653E\u984C\u898B\u305F\u308A\u3001\u8A71\u3057\u305F\u308A\u3057\u3066\u307F\u305F\u3044\u306A\u3001\u3068\u304B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u5C11\u3057\u3001\u601D\u3063\u305F\uFF09"
    CharacterName: "\u81EA\u5206"
  endType: 0
