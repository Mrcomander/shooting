    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u6765\u308B\u571F\u66DC\u65E5"
    CharacterName: 
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\u308F\u305F\u3057\u306F\u3001\u304A\u51FA\u304B\u3051\u306E\u652F\u5EA6\u306B\u624B\u3053\u305A\u3063\u3066\u3044\u305F\u306E\u3067\u3057\u305F"
    CharacterName: 
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u3080\u308A\u3080\u308A\u3080\u308A\uFF01\uFF09"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u306A\u3093\u3067\u308F\u305F\u3057\u3001\u3042\u3093\u306A\u3053\u3068\u52E2\u3044\u3067\u8A00\u3063\u3061\u3083\u3063\u305F\u306E\u2026\u2026\u3063\uFF09"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u62BD\u9078\u4F1A\u3068\u306F\u3044\u3048\u3001\u30AF\u30E9\u30B9\u306E\u7537\u306E\u5B50\u3068\u30E2\u30FC\u30EB\u306B\u304A\u51FA\u304B\u3051\u306A\u3093\u3066\u2026\u2026\uFF09"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u2015\u2015\u30C7\u30FC\u30C8\u3058\u3083\u3093\uFF01\uFF09"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u3053\u3046\u3044\u3046\u3068\u304D\u3063\u3066\u3001\u3069\u3093\u306A\u670D\u7740\u308C\u3070\u3044\u3044\u3093\u3060\u308D\u3046\u2026\u2026\uFF09"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u3082\u3046\u6642\u9593\u306A\u306E\u306B\u3001\u3084\u3070\u3044\u3001\u306A\u3093\u304B\u7DCA\u5F35\u3057\u3066\u304D\u305F\u2026\u2026\uFF09"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: 2585ded4e876ac34ba4b1d7ea474beb1, type: 3}
    CharacterImage: {fileID: 21300000, guid: c6d5576328f90a74c84cd5d61cea6b49, type: 3}
    StoryText: "\uFF08\u3046\u3045\u3045\u2026\u2026\u2026\u2026\uFF09"
