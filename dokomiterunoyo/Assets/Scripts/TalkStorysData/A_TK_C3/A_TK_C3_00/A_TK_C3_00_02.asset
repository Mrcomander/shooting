    CharacterImage: {fileID: 0}
    StoryText: "\uFF08\u2026\u2026\u306B\u3057\u3066\u3082\u3001\u5411\u3053\u3046\u306F\u3067\u3001\u30C7\u30FC\u30C8\u3068\u304B\u3001\u305D\u3046\u3044\u3046\u98A8\u306B\u306F\u601D\u3063\u3066\u306A\u3044\u3093\u3060\u308D\u3046\u304B\uFF09"
