  - Background: {fileID: 21300000, guid: 4ecfcb0204cee2e4790732992aa1cd5a, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\uFF08\u2026\u2026\u3050\u306C\u306C\uFF09"
    CharacterName: 
  - Background: {fileID: 21300000, guid: 4ecfcb0204cee2e4790732992aa1cd5a, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\uFF08\u4FFA\u3072\u3068\u308A\u3060\u3051\u3001\u821E\u3044\u4E0A\u304C\u3063\u3066\u3093\u306E\u304B\u306A\u2026\u2026\uFF09"
