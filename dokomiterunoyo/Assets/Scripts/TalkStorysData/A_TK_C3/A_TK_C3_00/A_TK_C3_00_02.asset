    StoryText: "\u670D\u88C5\u3082\u81EA\u5206\u306A\u308A\u306B\u30D9\u30B9\u30C8\u306A\u306E\u3092\u9078\u3093\u3060\u3057\u3001\u305D\u306E\u4ED6\u8EAB\u3060\u3057\u306A\u307F\u3082\u3061\u3083\u3093\u3068\u6574\u3048\u305F\uFF09"
