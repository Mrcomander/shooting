  m_Script: {fileID: 11500000, guid: 5a51659b9da73494e8667fc1d95e6ec3, type: 3}
  m_Name: A_TK_C0_02_AfterClass
  m_EditorClassIdentifier: Assembly-CSharp::StoryData
  stories:
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u30AD\u30FC\u30F3\u30B3\u30FC\u30F3\u30AB\u30FC\u30F3\u30B3\u30FC\u30F3"
    CharacterName: 
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\uFF08\u306F\u3041\u2026\u2026\u3084\u3063\u3068\u6388\u696D\u304C\u7D42\u308F\u3063\u305F\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\uFF08\u9670\u30AD\u30E3\u30DC\u30C3\u30C1\u306E\u4FFA\u306F\u5F53\u7136\u5E30\u5B85\u90E8\u3060\u3057\u3001\u4E00\u7DD2\u306B\u5E30\u308B\u53CB\u9054\u3082\u3044\u306A\u3044\u3002\u5E30\u3063\u3066\u3082\u30B2\u30FC\u30E0\u4EE5\u5916\u306B\u3084\u308B\u3053\u3068\u306A\u3044\u3001\u307E\u3067\u304C\u30BB\u30C3\u30C8\u3060\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u3066\u304B\u4F0A\u624B\u3061\u3083\u3093\u3001\u4ECA\u65E5\u306E\u6570\u5B66\u306E\u6388\u696D\u304B\u3063\u3053\u3088\u304B\u3063\u305F\u306D\u300D"
    CharacterName: "\u5973\u5B50\u751F\u5F92A"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u3048\u30FC\u3001\u30DE\u30B8\u305D\u308C\u306A\u3002\u3075\u307F\u3063\u3061\u3001\u307E\u3058\u30A6\u30C1\u3089\u306E\u81EA\u6162\u306E\u59D4\u54E1\u9577\u3060\u308F\u30FC\u300D"
    CharacterName: "\u5973\u5B50\u751F\u5F92B"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3046\u3046\u3093\u3001\u305D\u3093\u306A\u3053\u3068\u306A\u3044\u3088\u3002\u3042\u308C\u306F\u672C\u5F53\u306B\u305F\u307E\u305F\u307E\u3060\u3057\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u3060\u304B\u3089\u3055\u3002\u79C1\u304B\u3089\u3059\u308C\u3070\u3001\u307F\uFF5E\u3093\u306A\u3001\u81EA\u6162\u306E\u30AF\u30E9\u30B9\u30E1\u30A4\u30C8\u3060\u3088\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u305D\u308C\u306B\u3001\u3053\u306E\u30AF\u30E9\u30B9\u306F\u307F\u3093\u306A\u3044\u3044\u5B50\u3060\u304B\u3089\u3001\u59D4\u54E1\u9577\u306E\u4ED5\u4E8B\u3082\u307B\u3068\u3093\u3069\u306A\u3044\u3057\u306D\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u306F\u308F\u308F\u2026\u2026\u4F0A\u624B\u3061\u3083\u3093\u3001\u5929\u4F7F\u3060\u308F\u300D"
    CharacterName: "\u5973\u5B50\u751F\u5F92A"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3048\u30FC\u3001\u30DE\u30B8\u305D\u308C\u306A\u3002\u3066\u304B\u3055\u30FC\u3001\u5E30\u308A\u30AB\u30D5\u30A7\u5BC4\u3063\u3066\u304B\u3093\uFF1F\u300D"
    CharacterName: "\u5973\u5B50\u751F\u5F92B"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3044\u3044\u3051\u3069\u2026\u2026\u3001\u3042\u308C\u3001\u305F\u3057\u304B\u4ECA\u9031\u3058\u3083\u306A\u304B\u3063\u305F\u3063\u3051\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3053\u3093\u3057\u3085\u3046\uFF1F\u3000\u2026\u2026\u3063\u3066\u3001\u306A\u306B\u304C\uFF1F\u300D"
    CharacterName: "\u5973\u5B50\u751F\u5F92B"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u6383\u9664\u5F53\u756A\u3060\u3088\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3052\u3001\u672C\u5F53\u3058\u3083\u3093\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3052\u3001\u4FFA\u3082\u3058\u3083\u3093\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3084\u3063\u3079\u3001\u5B8C\u5168\u306B\u5FD8\u308C\u3066\u305F\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u30B5\u30DC\u3063\u305F\u308A\u3057\u3061\u3083\u30C0\u30E1\u3060\u3088\uFF5E\u3002\u2026\u2026\u3042\u3001\u308F\u305F\u3057\u3001\u5148\u751F\u306B\u4ED5\u4E8B\u983C\u307E\u308C\u3066\u305F\u3093\u3060\u3063\u305F\u3002\u3054\u3081\u3093\u306D\uFF01\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u2026\u2026\u2026\u2026\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u300E\u307F\u3093\u306A\u3044\u3044\u5B50\u300F\u300E\u81EA\u6162\u306E\u30AF\u30E9\u30B9\u30E1\u30A4\u30C8\u300F\u306D\u3047\u2026\u2026\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u6B63\u76F4\u3001\u30B5\u30DC\u3063\u3066\u5E30\u3063\u3066\u3057\u307E\u3044\u305F\u3044\u304C\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u2026\u2026\u4F0A\u624B\u3055\u3093\u306E\u671F\u5F85\u306F\u3001\u88CF\u5207\u308C\u306A\u3044\u304B\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u6642\u9593\u7D4C\u904E\uFF08\u5834\u9762\u8EE2\u63DB\u306E\u30AB\u30C3\u30C8\u30A4\u30F3\uFF09\u5165\u308C\u308B\u3068\u3053\u308D"
    CharacterName: "\u30E1\u30E2"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u304F\u3063\u305D\u3001\u7D50\u5C40\u3042\u3044\u3064\u3089\u2026\u2026\u4FFA\u306B\u5168\u90E8\u62BC\u3057\u4ED8\u3051\u3066\u5E30\u308A\u3084\u304C\u3063\u305F\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u30AC\u30E9\u30AC\u30E9\u30AC\u30E9"
    CharacterName: 
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 0}
    StoryText: "\u300C\u2015\u2015\uFF01\uFF1F\u3000\u3044\u3001\u4F0A\u624B\u3055\u3093\uFF1F\u3000\u3069\u3001\u3069\u3046\u3057\u3066\u2026\u2026\u300D"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u308F\u305F\u3057\u306F\u3001\u5148\u751F\u306B\u4ED5\u4E8B\u983C\u307E\u308C\u3066\u3057\u307E\u3063\u3066\u3002\u541B\u306E\u307B\u3046\u306F\u2026\u2026\u3042\u3001\u3082\u3057\u304B\u3057\u3066\u6383\u9664\u5F53\u756A\uFF1F\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\u300C\u3082\u3057\u304B\u3057\u3066\u2026\u2026\u3072\u3068\u308A\u3067\u3084\u3063\u3066\u304F\u308C\u3066\u305F\u306E?\u300D"
    CharacterName: "\u6587\u82B1"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u3053\u308C\u2026\u2026\u30DE\u30B8\u304B\uFF09"
    CharacterName: "\u81EA\u5206"
  - Background: {fileID: 21300000, guid: e257efbd698fda14ba22dce52ffaa9c0, type: 3}
    CharacterImage: {fileID: 21300000, guid: 3797f4095fb94794ea83c70edee3cd18, type: 3}
    StoryText: "\uFF08\u61A7\u308C\u306E\u4F0A\u624B\u3055\u3093\u3068\u3001\u4E8C\u4EBA\u3063\u304D\u308A\u306A\u3093\u3060\u3051\u3069\u2015\u2015\uFF01\uFF1F\uFF09"
    CharacterName: "\u81EA\u5206"
  endType: 3
